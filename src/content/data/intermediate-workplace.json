          "choices": [
            { "choiceId": "c1", "text": "colleague" },
            { "choiceId": "c2", "text": "college" },
            { "choiceId": "c3", "text": "community" },
            { "choiceId": "c4", "text": "company" }
          ],
          "answerChoiceId": "c1",
          "explanation": "colleague=同僚。college (大学)・company (会社) と綴りが近く紛らわしい。"
        },
        {
          "quizId": "q-i03",
          "type": "choose-term",
          "wordId": "improve",
