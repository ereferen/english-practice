  "source": "サンプルcontent (自作のプレースホルダ。本番は公開単語リストをF6のCSV取り込みで生成する。独自コンテンツ制作は行わない=前提A4)",
  "lessons": [
    {
      "lessonId": "l01-workplace",
      "title": "職場で",
      "theme": "仕事",
      "words": [
        {
          "wordId": "schedule",
          "term": "schedule",
          "reading": "スキジュール",
          "meaning": "予定; 計画を立てる",
          "partOfSpeech": "noun",
          "examples": [
            {
              "en": "Let's reschedule the meeting for Friday.",
              "ja": "会議を金曜日に組み直しましょう。"
            }
          ],
          "note": "米発音 /skedʒuːl/、英発音 /ʃedjuːl/。"
        },
        {
          "wordId": "colleague",
          "term": "colleague",
          "reading": "カリーグ",
          "meaning": "同僚",
          "partOfSpeech": "noun",
          "examples": [
            {
              "en": "A colleague of mine recommended this app.",
              "ja": "同僚がこのアプリを教えてくれました。"
            }
          ],
          "tags": ["people"]
        },
        {
          "wordId": "deadline",
          "term": "deadline",
          "reading": "デッドライン",
          "meaning": "締切",
          "partOfSpeech": "noun",
          "examples": [
            {
              "en": "We need to meet the deadline by Monday.",
              "ja": "月曜日までに締切に間に合わせる必要があります。"
            }
          ]
        },
        {
          "wordId": "improve",
          "term": "improve",
          "reading": "インプルーブ",
          "meaning": "改善する",
          "partOfSpeech": "verb",
          "examples": [
            {
              "en": "I want to improve my English vocabulary.",
              "ja": "英語の語彙を改善したいです。"
            }
          ]
        },
        {
          "wordId": "careful",
          "term": "careful",
          "reading": "ケアフル",
          "meaning": "注意深い; 慎重な",
          "partOfSpeech": "adjective",
          "examples": [
            {
              "en": "Be careful when you cross the street.",
              "ja": "道路を渡るときは注意してください。"
            }
          ]
        }
      ],
      "quizzes": [
        {
