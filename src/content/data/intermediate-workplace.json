            { "choiceId": "c2", "text": "improve" },
            { "choiceId": "c3", "text": "include" },
            { "choiceId": "c4", "text": "introduce" }
          ],
          "answerChoiceId": "c2"
        }
      ]
    },
    {
      "lessonId": "l02-opinions",
      "title": "意見を知る",
      "theme": "思考・表現",
      "words": [
        {
          "wordId": "probably",
          "term": "probably",
          "reading": "プロバブリィ",
          "meaning": "おそらく",
          "partOfSpeech": "adverb",
          "examples": [
            {
              "en": "It will probably rain this afternoon.",
              "ja": "午後はたぶん雨が降るでしょう。"
            }
          ]
        },
        {
          "wordId": "agree",
          "term": "agree",
          "reading": "アグリー",
          "meaning": "同意する",
          "partOfSpeech": "verb",
          "examples": [
            {
              "en": "I agree with your idea.",
              "ja": "あなたの考えに同意します。"
            }
          ],
          "note": "「〜に同意する」は agree with + 人/意見。"
        },
        {
          "wordId": "different",
          "term": "different",
          "reading": "ディファレント",
          "meaning": "異なる",
          "partOfSpeech": "adjective",
          "examples": [
            {
              "en": "This result is different from the previous one.",
              "ja": "この結果は以前のものとは異なります。"
            }
          ]
        },
        {
          "wordId": "decide",
          "term": "decide",
          "reading": "デサイド",
          "meaning": "決める; 決定する",
          "partOfSpeech": "verb",
          "examples": [
            {
              "en": "We decided to launch the feature next month.",
              "ja": "私たちは来月その機能を公開することに決めました。"
            }
          ]
        },
        {
          "wordId": "enough",
          "term": "enough",
          "reading": "イナフ",
          "meaning": "十分な; 十分に",
          "partOfSpeech": "adjective",
          "examples": [
            {
              "en": "Do we have enough time before the meeting?",
              "ja": "会議までに十分な時間はありますか。"
            }
          ]
        }
      ]
